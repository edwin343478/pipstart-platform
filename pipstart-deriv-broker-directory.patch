+.page {
+  display: flex;
+  min-height: 100vh;
+  flex-direction: column;
+  background: #f5f7f8;
+  color: #0b1220;
+}
+
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  padding: 1rem 2.75rem;
+  border-bottom: 1px solid #d9e0e5;
+  background: #fff;
+}
+
+.header a {
+  color: #0b1220;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 1.25rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.header span {
+  color: #0f766e;
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+
+.content {
+  width: min(calc(100% - 5.5rem), 68rem);
+  flex: 1;
+  margin: 0 auto;
+  padding: 3.25rem 0 3.5rem;
+}
+
+.introduction {
+  margin-bottom: 1.5rem;
+}
+
+.introduction h1 {
+  margin: 0 0 1rem;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: clamp(2rem, 4vw, 2.625rem);
+  font-weight: 800;
+  letter-spacing: -0.025em;
+}
+
+.disclosure {
+  border: 1px solid #d9e0e5;
+  border-radius: 0.625rem;
+  background: #fafbfc;
+  color: #667085;
+  font-size: 0.8125rem;
+  line-height: 1.55;
+  padding: 0.85rem 1rem;
+}
+
+.disclosure strong {
+  color: #0b1220;
+}
+
+.broker {
+  display: grid;
+  grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
+  overflow: hidden;
+  margin-bottom: 1rem;
+  border: 1px solid #d9e0e5;
+  border-radius: 0.875rem;
+  background: #fff;
+}
+
+.creative {
+  display: block;
+  min-height: 100%;
+  overflow: hidden;
+  background: #0b1517;
+}
+
+.creative img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: transform 240ms ease;
+}
+
+.creative:hover img,
+.creative:focus-visible img {
+  transform: scale(1.015);
+}
+
+.brokerDetails {
+  padding: 2rem;
+}
+
+.brokerHeading {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 1rem;
+  margin-bottom: 1rem;
+}
+
+.brokerHeading p {
+  margin: 0 0 0.35rem;
+  color: #0f766e;
+  font-size: 0.6875rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.brokerHeading h2 {
+  margin: 0;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 1.5rem;
+  font-weight: 800;
+}
+
+.brokerHeading > span {
+  border: 1px solid #d9e0e5;
+  border-radius: 999px;
+  color: #667085;
+  font-size: 0.6875rem;
+  font-weight: 600;
+  padding: 0.35rem 0.65rem;
+}
+
+.summary {
+  margin: 0 0 1rem;
+  color: #667085;
+  font-size: 0.875rem;
+  line-height: 1.65;
+}
+
+.tagline {
+  margin: 0 0 1.25rem;
+  color: #0b1220;
+  font-weight: 600;
+  line-height: 1.55;
+}
+
+.facts {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.75rem;
+  margin: 0 0 1.5rem;
+}
+
+.facts div {
+  border: 1px solid #e4e9ed;
+  border-radius: 0.5rem;
+  background: #fafbfc;
+  padding: 0.75rem;
+}
+
+.facts dt {
+  margin-bottom: 0.3rem;
+  color: #8a93a0;
+  font-size: 0.6875rem;
+  text-transform: uppercase;
+}
+
+.facts dd {
+  margin: 0;
+  color: #0b1220;
+  font-size: 0.8125rem;
+  font-weight: 600;
+}
+
+.actions {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem 1rem;
+}
+
+.actions a {
+  border-radius: 0.5rem;
+  background: #0f766e;
+  color: #fff;
+  font-size: 0.875rem;
+  font-weight: 600;
+  padding: 0.75rem 1.25rem;
+  text-decoration: none;
+}
+
+.actions a:hover,
+.actions a:focus-visible {
+  background: #115e59;
+}
+
+.actions span {
+  color: #8a93a0;
+  font-size: 0.6875rem;
+}
+
+.riskNotice {
+  margin-bottom: 0.75rem;
+  border: 1px solid #fde68a;
+  border-radius: 0.625rem;
+  background: #fffbeb;
+  color: #92400e;
+  font-size: 0.8125rem;
+  line-height: 1.55;
+  padding: 0.9rem 1rem;
+}
+
+.verified {
+  margin: 0;
+  color: #8a93a0;
+  font-size: 0.75rem;
+}
+
+.footer {
+  padding: 1.25rem 2.75rem;
+  border-top: 1px solid #d9e0e5;
+  background: #fff;
+  color: #667085;
+  font-size: 0.75rem;
+}
+
+@media (max-width: 760px) {
+  .broker {
+    grid-template-columns: 1fr;
+  }
+
+  .creative {
+    max-height: 34rem;
+  }
+}
+
+@media (max-width: 640px) {
+  .header,
+  .footer {
+    padding-right: 1.25rem;
+    padding-left: 1.25rem;
+  }
+
+  .content {
+    width: calc(100% - 2.5rem);
+    padding-top: 2.75rem;
+  }
+
+  .brokerDetails {
+    padding: 1.5rem;
+  }
+
+  .facts {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .creative img {
+    transition: none;
+  }
+
+  .creative:hover img,
+  .creative:focus-visible img {
+    transform: none;
+  }
+}
