diff --git a/apps/pipstart/src/lib/public-content.test.ts b/apps/pipstart/src/lib/public-content.test.ts
new file mode 100644
index 0000000..a74205d
--- /dev/null
+++ b/apps/pipstart/src/lib/public-content.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+
+import { selectPublishedContent } from "./public-content";
+
+describe("public content visibility", () => {
+  it("returns published records and excludes drafts", () => {
+    const entries = [
+      { slug: "published-entry", status: "published" as const },
+      { slug: "draft-entry", status: "draft" as const },
+    ];
+
+    expect(selectPublishedContent(entries)).toEqual([entries[0]]);
+  });
+
+  it("does not mutate the editorial source collection", () => {
+    const entries = [
+      { slug: "draft-entry", status: "draft" as const },
+      { slug: "published-entry", status: "published" as const },
+    ];
+
+    selectPublishedContent(entries);
+
+    expect(entries.map((entry) => entry.slug)).toEqual([
+      "draft-entry",
+      "published-entry",
+    ]);
+  });
+});
diff --git a/apps/pipstart/src/lib/public-content.ts b/apps/pipstart/src/lib/public-content.ts
new file mode 100644
index 0000000..94d994b
--- /dev/null
+++ b/apps/pipstart/src/lib/public-content.ts
@@ -0,0 +1,11 @@
+export type PublicationStatus = "draft" | "published";
+
+export type PublishableContent = {
+  status: PublicationStatus;
+};
+
+export function selectPublishedContent<T extends PublishableContent>(
+  entries: readonly T[],
+): T[] {
+  return entries.filter((entry) => entry.status === "published");
+}
