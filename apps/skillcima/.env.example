# Public Cloudflare Turnstile sitekey used by the browser.
# This value is safe to expose publicly.
# Production must use the real Skillcima Turnstile sitekey.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional public base URL for the Skillcima Worker API.
# Leave blank when the website and Worker use the same origin.
# Example for separate local development:
# NEXT_PUBLIC_LEAD_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_LEAD_API_URL=