{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skillcima",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-06",
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "SKILLCIMA_CONFIRMATION_TOKEN_SECRET",
      "RESEND_API_KEY",
    ],
  },
  "vars": {
    "SKILLCIMA_EMAIL_FROM": "Skillcima <course@skillcima.com>",
    "SKILLCIMA_PUBLIC_ORIGIN": "https://skillcima.com",
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SKILLCIMA_EMAIL_QUEUE",
        "queue": "skillcima-email",
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
}
