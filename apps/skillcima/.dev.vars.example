# Cloudflare Turnstile server-side secret.
# The value below is Cloudflare's public development/test key.
# Production uses a real secret stored with Wrangler secrets.

TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Server-only Supabase configuration.
# Local development values come from `pnpm supabase status -o env`.
# Production values must be stored securely with Cloudflare.
# Never expose SUPABASE_SECRET_KEY to browser code.

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SECRET_KEY="replace-with-server-only-secret-key"
# Confirmation-email delivery secrets.
#
# SKILLCIMA_CONFIRMATION_TOKEN_SECRET must be a strong,
# server-only secret of at least 32 UTF-8 bytes.
# It is used to derive stable confirmation tokens.
#
# RESEND_API_KEY is the server-only Resend API credential.
# Never commit either production value.

SKILLCIMA_CONFIRMATION_TOKEN_SECRET="replace-with-at-least-32-byte-server-secret"
RESEND_API_KEY="re_replace-with-server-only-api-key"
