# Public Supabase project configuration. These values are safe for the browser;
# database access remains protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"

# Server-only administrative credential used solely for verified account deletion.
# Never expose this value through a NEXT_PUBLIC_ variable or browser code.
SUPABASE_SECRET_KEY="replace-with-server-only-secret-key"

# Must match an allowed Supabase Auth redirect origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
