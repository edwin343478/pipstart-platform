+}
+
+.related span {
+  color: #0f766e;
+  font-size: 0.6875rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.related h2 {
+  margin: 0.2rem 0 0;
