+      expect(metadata.openGraph?.url).toBe(entry.path);
+      expect(metadata.twitter).toMatchObject({ card: "summary_large_image" });
+    }
+  });
+
+  it("publishes every registered route in the sitemap", () => {
+    const urls = sitemap().map((entry) => entry.url);
