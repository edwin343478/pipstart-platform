+  return (
+    <PublicPageShell>
+      <article>
+        <p className={styles.eyebrow}>Important information</p>
+        <h1 className={styles.title}>Risk Disclaimer</h1>
+        <p className={styles.updated}>Last updated: 9 September 2026</p>
+
+        <div className={styles.content}>
+          <aside className={styles.notice}>
+            <h2>Trading involves substantial financial risk</h2>
+            <p>
+              Forex and cryptocurrency markets can be highly volatile. You can
+              lose some or all of the money committed to trading.
+            </p>
+          </aside>
+          <section className={styles.section}>
+            <h2>Leverage can increase losses</h2>
+            <p>
+              Leveraged products magnify exposure. A small market movement can
+              therefore cause a large loss, and broker protections and margin
+              rules differ.
+            </p>
+          </section>
+          <section className={styles.section}>
+            <h2>Crypto has additional risks</h2>
+            <p>
