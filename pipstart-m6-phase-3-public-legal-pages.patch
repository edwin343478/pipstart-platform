@@ -0,0 +1,61 @@
+import fs from "node:fs";
+import path from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+const appRoot = path.resolve(import.meta.dirname);
+
+const publicRoutes = [
+  "start-here/page.tsx",
+  "about/page.tsx",
+  "contact/page.tsx",
+  "legal/privacy-policy/page.tsx",
+  "legal/terms/page.tsx",
+  "legal/cookie-policy/page.tsx",
+  "legal/risk-disclaimer/page.tsx",
+];
+
+describe("PipStart public pages", () => {
+  it.each(publicRoutes)("provides the %s route", (route) => {
+    expect(fs.existsSync(path.join(appRoot, route))).toBe(true);
+  });
+
+  it("keeps footer navigation on first-party PipStart routes", () => {
+    const footer = fs.readFileSync(
+      path.join(appRoot, "../components/public-page-shell.tsx"),
+      "utf8",
+    );
+
+    expect(footer).toContain('href="/about"');
+    expect(footer).toContain('href="/contact"');
+    expect(footer).toContain('href="/legal/privacy-policy"');
+    expect(footer).toContain('href="/legal/terms"');
+    expect(footer).toContain('href="/legal/cookie-policy"');
+    expect(footer).toContain('href="/legal/risk-disclaimer"');
+    expect(footer).not.toContain("skillcima.com");
+  });
+
+  it("discloses affiliate compensation in the shared footer", () => {
+    const footer = fs.readFileSync(
+      path.join(appRoot, "../components/public-page-shell.tsx"),
+      "utf8",
+    );
+
+    expect(footer).toContain("affiliate links");
+    expect(footer).toContain("no additional cost");
+  });
+
+  it("documents browser-local lesson progress accurately", () => {
+    const privacy = fs.readFileSync(
+      path.join(appRoot, "legal/privacy-policy/page.tsx"),
+      "utf8",
+    );
+    const cookies = fs.readFileSync(
+      path.join(appRoot, "legal/cookie-policy/page.tsx"),
+      "utf8",
+    );
+
+    expect(privacy).toContain("local storage");
+    expect(cookies).toContain("Local storage is not a cookie");
+  });
+});
