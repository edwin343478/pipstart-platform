+            <section className={styles.card}>
+              <h2>New to currency markets?</h2>
+              <p>
+                Begin with Forex fundamentals, including currency pairs, pips,
+                position sizing and risk.
+              </p>
+              <Link className={styles.textLink} href="/learn/forex">
+                Start learning Forex →
+              </Link>
+            </section>
+            <section className={styles.card}>
+              <h2>New to digital assets?</h2>
+              <p>
+                Begin with cryptocurrency foundations, wallets, exchanges and
+                the risks that make crypto different.
+              </p>
+              <Link className={styles.textLink} href="/learn/crypto">
+                Start learning crypto →
+              </Link>
+            </section>
+          </div>
+
+          <section className={styles.section}>
+            <h2>A simple learning order</h2>
+            <ol>
+              <li>Read one lesson at a time and complete its key points.</li>
+              <li>Check unfamiliar language in the glossary.</li>
+              <li>Use calculators to practise the numbers without trading.</li>
+              <li>Read the risk disclosure before considering real money.</li>
+            </ol>
+          </section>
+
+          <aside className={styles.notice}>
+            <h2>Education, not a signal service</h2>
+            <p>
+              PipStart does not tell you what to buy or sell and does not
+              guarantee outcomes. Markets can move against you, and leverage can
+              make losses larger.
+            </p>
+          </aside>
+        </div>
+      </article>
+    </PublicPageShell>
+  );
+}
