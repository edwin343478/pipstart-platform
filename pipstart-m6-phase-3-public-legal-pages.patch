+.page {
+  min-height: 100vh;
+  background: #f5f7f8;
+  color: #0b1220;
+}
+
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  padding: 1rem 2.75rem;
+  border-bottom: 1px solid #d9e0e5;
+  background: #fff;
+}
+
+.brand {
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 1.25rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.header nav,
+.footer nav {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.75rem 1.25rem;
+  color: #667085;
+  font-size: 0.8125rem;
+}
+
+.header nav a,
+.footer a {
+  text-decoration: none;
+}
+
+.header nav a:hover,
+.header nav a:focus-visible,
+.footer a:hover,
+.footer a:focus-visible {
+  color: #0f766e;
+  text-decoration: underline;
+  text-underline-offset: 0.2rem;
+}
+
+.main {
+  width: min(100% - 2.5rem, 48rem);
+  margin: 0 auto;
+  padding: 4rem 0 5rem;
+}
+
+.footer {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  align-items: center;
+  gap: 0.75rem 2rem;
+  padding: 1rem 3.5rem 1.5rem;
+  border-top: 1px solid #d9e0e5;
+  background: #fff;
+  color: #667085;
+  font-size: 0.75rem;
+}
+
+.footer nav {
+  justify-content: flex-end;
+}
+
+.footer p {
+  grid-column: 1 / -1;
+  margin: 0;
+  color: #7c8491;
+  line-height: 1.5;
+}
+
+@media (max-width: 700px) {
+  .header {
+    align-items: flex-start;
+    flex-direction: column;
+    padding-inline: 1.25rem;
+  }
+
+  .main {
+    width: min(100% - 2.5rem, 48rem);
+    padding-block: 3rem 4rem;
+  }
+
+  .footer {
+    grid-template-columns: 1fr;
+    padding-inline: 1.25rem;
+  }
+
+  .footer nav {
+    justify-content: flex-start;
+  }
+
+  .footer p {
+    grid-column: auto;
+  }
+}
