+  return (
+    <PublicPageShell>
+      <article>
+        <p className={styles.eyebrow}>Start here</p>
+        <h1 className={styles.title}>Build knowledge before risking money.</h1>
+        <p className={styles.lead}>
+          Choose one learning path, work through it in order, and use the
+          glossary and calculators when a lesson introduces a new term or
