{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["PIPSTART_STORE_FAMILIES", "VERCEL_DEPLOYMENT_ID"],
      "passThroughEnv": ["SUPABASE_SECRET_KEY"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "clean": {
      "cache": false
    }
  }
}
