+
+  .content {
+    width: calc(100% - 2.5rem);
+    padding-top: 2.75rem;
+  }
+
+  .fields {
+    grid-template-columns: 1fr;
+  }
+}
diff --git a/apps/pipstart/src/app/tools/position-size-calculator/page.tsx b/apps/pipstart/src/app/tools/position-size-calculator/page.tsx
