+  padding: 0.75rem 0.875rem;
+}
+
+.fields input:focus,
+.fields select:focus {
+  border-color: #0f766e;
+  box-shadow: 0 0 0 3px rgb(15 118 110 / 12%);
+}
+
+.calculator button {
+  border: 0;
+  border-radius: 0.5rem;
+  background: #0f766e;
+  color: #fff;
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.875rem;
+  font-weight: 600;
+  padding: 0.8rem 1.5rem;
+}
+
+.calculator button:hover,
+.calculator button:focus-visible {
+  background: #115e59;
+}
+
+.error {
+  margin: -0.25rem 0 1rem;
+  color: #b42318;
+  font-size: 0.8125rem;
+}
+
+.result {
+  margin-bottom: 1.5rem;
+  border-radius: 0.75rem;
+  background: #0b1220;
+  padding: 1.75rem;
+  text-align: center;
+}
+
+.result h2 {
+  margin: 0 0 0.45rem;
+  color: #8fa0b5;
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.result p {
+  margin: 0;
+  color: #14b8a6;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: clamp(2rem, 5vw, 2.75rem);
+  font-weight: 800;
+}
+
+.result div {
+  margin-top: 0.6rem;
+  color: #8fa0b5;
+  font-size: 0.8125rem;
+}
+
+.disclaimer {
+  border: 1px solid #fde68a;
+  border-radius: 0.625rem;
+  background: #fffbeb;
+  color: #92400e;
+  font-size: 0.8125rem;
+  line-height: 1.55;
+  padding: 0.9rem 1rem;
