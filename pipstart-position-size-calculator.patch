+.page {
+  display: flex;
+  min-height: 100vh;
+  flex-direction: column;
+  background: #f5f7f8;
+  color: #0b1220;
+}
+
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+  padding: 1rem 2.75rem;
+  border-bottom: 1px solid #d9e0e5;
+  background: #fff;
+}
+
+.header > a {
+  color: #0b1220;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 1.25rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.header nav {
+  color: #667085;
+  font-size: 0.875rem;
+}
+
+.header nav a {
+  color: inherit;
+  text-decoration: none;
+}
+
+.header nav a:hover,
+.header nav a:focus-visible {
+  color: #0f766e;
+}
+
+.content {
+  width: min(calc(100% - 5.5rem), 58rem);
+  flex: 1;
+  margin: 0 auto;
+  padding: 3.5rem 0;
+}
+
+.introduction {
+  margin-bottom: 1.75rem;
+}
+
+.introduction h1 {
+  margin: 0 0 0.55rem;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: clamp(2rem, 4vw, 2.625rem);
+  font-weight: 800;
+  letter-spacing: -0.025em;
+}
+
+.introduction p {
+  margin: 0;
+  color: #667085;
+  line-height: 1.6;
+}
+
+.calculator {
+  margin-bottom: 1.5rem;
+}
+
+.fields {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 1rem;
+  margin-bottom: 1.25rem;
+}
+
+.fields label {
+  display: block;
+}
+
+.fields label > span {
+  display: block;
+  margin-bottom: 0.4rem;
+  color: #667085;
+  font-size: 0.8125rem;
+}
+
+.fields input,
+.fields select {
+  width: 100%;
+  border: 1px solid #d9e0e5;
+  border-radius: 0.5rem;
+  outline: 0;
+  background: #fff;
+  color: #0b1220;
