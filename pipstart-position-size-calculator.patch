+++ b/apps/pipstart/src/app/tools/position-size-calculator/page.tsx
@@ -0,0 +1,153 @@
+"use client";
+
+import Link from "next/link";
+import { FormEvent, useState } from "react";
+
+import styles from "./page.module.css";
+
+const pairs = ["EUR/USD", "GBP/USD", "AUD/USD", "NZD/USD"];
+const PIP_VALUE_PER_UNIT = 0.0001;
+
+type Result = { balance: number; positionSize: number; riskAmount: number };
+
+function calculate(balance: number, riskPercent: number, stopLoss: number) {
+  const riskAmount = balance * (riskPercent / 100);
+  return {
+    balance,
+    riskAmount,
+    positionSize: Math.floor(riskAmount / (stopLoss * PIP_VALUE_PER_UNIT)),
+  };
+}
+
+export default function PositionSizeCalculatorPage() {
+  const [balance, setBalance] = useState("1000");
+  const [riskPercent, setRiskPercent] = useState("1");
+  const [stopLoss, setStopLoss] = useState("25");
+  const [pair, setPair] = useState("EUR/USD");
+  const [error, setError] = useState("");
+  const [result, setResult] = useState<Result>(() => calculate(1000, 1, 25));
+
+  function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const values = [Number(balance), Number(riskPercent), Number(stopLoss)];
+
+    if (!values.every(Number.isFinite) || values.some((value) => value <= 0)) {
+      setError("Enter numbers greater than zero in every field.");
+      return;
+    }
+    if (values[1] > 100) {
+      setError("Risk per trade cannot be greater than 100%.");
+      return;
+    }
+
+    setError("");
+    setResult(calculate(values[0], values[1], values[2]));
+  }
+
+  return (
+    <main className={styles.page}>
+      <header className={styles.header}>
+        <Link href="/" aria-label="PipStart home">
+          PipStart
+        </Link>
+        <nav aria-label="Breadcrumb">
+          <Link href="/tools">Tools</Link>
+          <span aria-hidden="true"> / </span>
+          <span>Position Size</span>
+        </nav>
+      </header>
+
+      <div className={styles.content}>
+        <section className={styles.introduction}>
+          <h1>Position Size Calculator</h1>
+          <p>
+            Find the maximum position size that keeps your risk within your own
+            limit.
+          </p>
+        </section>
+
+        <form className={styles.calculator} onSubmit={submit} noValidate>
+          <div className={styles.fields}>
+            <label>
+              <span>Account balance</span>
+              <input
+                aria-label="Account balance"
+                type="number"
+                min="0.01"
+                step="0.01"
+                inputMode="decimal"
+                value={balance}
+                onChange={(event) => setBalance(event.target.value)}
+              />
+            </label>
+            <label>
+              <span>Risk per trade (%)</span>
+              <input
+                aria-label="Risk per trade percentage"
+                type="number"
+                min="0.01"
+                max="100"
+                step="0.01"
+                inputMode="decimal"
+                value={riskPercent}
+                onChange={(event) => setRiskPercent(event.target.value)}
+              />
+            </label>
+            <label>
+              <span>Stop loss (pips)</span>
+              <input
+                aria-label="Stop loss in pips"
+                type="number"
+                min="0.1"
+                step="0.1"
+                inputMode="decimal"
+                value={stopLoss}
+                onChange={(event) => setStopLoss(event.target.value)}
+              />
+            </label>
+            <label>
+              <span>Currency pair</span>
+              <select
+                aria-label="Currency pair"
+                value={pair}
+                onChange={(event) => setPair(event.target.value)}
+              >
+                {pairs.map((item) => (
+                  <option key={item}>{item}</option>
+                ))}
+              </select>
+            </label>
+          </div>
+
+          {error ? (
+            <p className={styles.error} role="alert">
+              {error}
+            </p>
+          ) : null}
+          <button type="submit">Calculate</button>
+        </form>
+
+        <section className={styles.result} aria-live="polite">
+          <h2>Maximum position size</h2>
+          <p>{result.positionSize.toLocaleString("en-US")} units</p>
+          <div>
+            Risking <span>$</span>
+            {result.riskAmount.toFixed(2)} of your <span>$</span>
+            {result.balance.toLocaleString("en-US", {
+              maximumFractionDigits: 2,
+            })}{" "}
+            balance
+          </div>
+        </section>
+
+        <aside className={styles.disclaimer}>
+          This is an educational estimate only, not a guarantee of outcome.
+          Actual broker execution, spreads and slippage will affect real
+          results.
+        </aside>
+      </div>
+
+      <footer className={styles.footer}>PipStart · pipstart.net</footer>
+    </main>
+  );
+}
