index 0000000..70b9429
--- /dev/null
+++ b/apps/pipstart/src/app/route-state.module.css
@@ -0,0 +1,226 @@
+.page {
+  display: grid;
+  min-height: 100vh;
+  grid-template-rows: auto 1fr auto;
+  background: #f5f7f8;
+  color: #0b1220;
+}
+
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 1rem 2.75rem;
+  border-bottom: 1px solid #d9e0e5;
+  background: #fff;
+}
+
+.brand {
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 0.9375rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.header > span {
+  color: #0f766e;
+  font-size: 0.8125rem;
+  font-weight: 600;
+}
+
+.main,
+.loadingMain {
+  display: grid;
+  width: min(100%, 52rem);
+  margin: 0 auto;
+  padding: 4.5rem 2rem;
+  place-items: center;
+}
+
+.card,
+.loadingCard {
+  width: min(100%, 36rem);
+  border: 1px solid #d9e0e5;
+  border-radius: 1rem;
+  background: #fff;
+  box-shadow: 0 1rem 2.75rem rgb(15 23 42 / 6%);
+  padding: 2.5rem;
+  text-align: center;
+}
+
+.eyebrow {
+  margin: 0 0 0.75rem;
+  color: #0f766e;
+  font-size: 0.75rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.card h1 {
+  margin: 0;
+  font-size: clamp(1.75rem, 4vw, 2.5rem);
+  font-weight: 800;
+  line-height: 1.15;
+  letter-spacing: -0.03em;
+}
+
+.description {
+  max-width: 30rem;
+  margin: 1rem auto 0;
+  color: #667085;
+  font-size: 0.9375rem;
+  line-height: 1.7;
+}
+
+.actions {
+  display: flex;
+  justify-content: center;
+  gap: 0.75rem;
+  margin-top: 1.75rem;
+}
+
+.primaryAction,
+.secondaryAction {
+  display: inline-flex;
+  min-height: 2.75rem;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid #0f766e;
+  border-radius: 0.625rem;
+  padding: 0.6875rem 1.125rem;
+  font-size: 0.8125rem;
+  font-weight: 750;
+  text-decoration: none;
+}
+
+.primaryAction {
+  background: #0f766e;
+  color: #fff;
+}
+
+.secondaryAction {
+  background: #fff;
+  color: #0f766e;
+}
+
+.primaryAction:hover {
+  background: #115e59;
+}
+
+.secondaryAction:hover {
+  background: #f0fdfa;
+}
+
+.primaryAction:focus-visible,
+.secondaryAction:focus-visible,
+.recoveryLinks a:focus-visible {
+  outline: 3px solid #14b8a6;
+  outline-offset: 3px;
+}
+
+.recoveryLinks {
+  display: flex;
+  justify-content: center;
+  gap: 1.25rem;
+  margin-top: 1.75rem;
+  padding-top: 1.25rem;
+  border-top: 1px solid #e6eaed;
+  font-size: 0.75rem;
+  font-weight: 700;
+}
+
+.recoveryLinks a {
+  color: #667085;
+  text-underline-offset: 0.2rem;
+}
+
+.loadingCard {
+  padding-block: 3rem;
+}
+
+.spinner {
+  display: block;
+  width: 2.25rem;
+  height: 2.25rem;
+  margin: 0 auto 1.25rem;
+  border: 3px solid #d9e0e5;
+  border-top-color: #0f766e;
+  border-radius: 50%;
+  animation: spin 0.8s linear infinite;
+}
+
+.loadingMessage {
+  margin: 0;
+  color: #0b1220;
+  font-size: 1rem;
+  font-weight: 800;
+}
+
+.loadingHint {
+  margin: 0.5rem 0 0;
+  color: #667085;
+  font-size: 0.8125rem;
+  line-height: 1.6;
+}
+
+.footer {
+  padding: 1rem 2.75rem;
+  border-top: 1px solid #d9e0e5;
+  background: #fff;
+  color: #667085;
+  font-size: 0.6875rem;
+}
+
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .spinner {
+    animation: none;
+    border-color: #0f766e;
+  }
+}
+
+@media (max-width: 767px) {
+  .page {
+    min-height: calc(100dvh - var(--mobile-tab-height));
+  }
+
+  .header,
+  .footer {
+    justify-content: flex-start;
+    gap: 0.625rem;
+    padding: 0.75rem 1.125rem;
+  }
+
+  .main,
+  .loadingMain {
+    width: 100%;
+    padding: 2rem 1.125rem;
+  }
+
+  .card,
+  .loadingCard {
+    border-radius: 0.875rem;
+    padding: 1.75rem 1.125rem;
+  }
+
+  .actions {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .primaryAction,
+  .secondaryAction {
+    width: 100%;
+  }
+
+  .recoveryLinks {
+    flex-wrap: wrap;
+    row-gap: 0.75rem;
+  }
+}
