@@ -0,0 +1,69 @@
+.notice {
+  margin: 0 0 1rem;
+  border: 1px solid #99f6e4;
+  border-radius: 0.75rem;
+  background: #f0fdfa;
+  padding: 1rem;
+  color: #115e59;
+  font-size: 0.82rem;
+  font-weight: 700;
+  line-height: 1.6;
+}
+
+.actions {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+}
+
+.primaryAction,
+.secondaryAction {
+  display: inline-flex;
+  min-height: 2.75rem;
+  align-items: center;
+  justify-content: center;
+  border-radius: 0.625rem;
+  padding: 0.65rem 1rem;
+  font-size: 0.8rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.primaryAction {
+  border: 1px solid var(--action);
+  background: var(--action);
+  color: var(--action-foreground);
+}
+
+.secondaryAction {
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--brand-accent);
+}
+
+.primaryAction:hover,
+.primaryAction:focus-visible {
+  background: var(--action-hover);
+}
+
+.secondaryAction:hover,
+.secondaryAction:focus-visible {
+  border-color: var(--brand-accent);
+}
+
+@media (max-width: 767px) {
+  .notice {
+    font-size: 12px;
+  }
+
+  .actions {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .primaryAction,
+  .secondaryAction {
+    width: 100%;
+    min-height: 44px;
+  }
+}
diff --git a/apps/pipstart/src/app/email-confirmed/page.tsx b/apps/pipstart/src/app/email-confirmed/page.tsx
new file mode 100644
index 0000000..464a3ab
--- /dev/null
+++ b/apps/pipstart/src/app/email-confirmed/page.tsx
@@ -0,0 +1,43 @@
+import type { Metadata } from "next";
+import Link from "next/link";
+
+import { AccountShell } from "@/components/account-shell";
+import { getCurrentUser } from "@/lib/auth/session";
+
+import styles from "./page.module.css";
+
+export const metadata: Metadata = {
+  title: "Email confirmed",
+  robots: { follow: false, index: false },
+};
+
+export default async function EmailConfirmedPage() {
+  const user = await getCurrentUser();
+
+  return (
+    <AccountShell
+      description="Your email address has been verified successfully."
+      title="Email confirmed"
+    >
+      <div className={styles.notice} role="status">
+        Your PipStart learner account is ready.
+      </div>
+      <p>
+        {user
+          ? "Continue to your account or return to the learning paths."
+          : "Log in with the email address and password you registered, then continue learning."}
+      </p>
+      <div className={styles.actions}>
+        <Link
+          className={styles.primaryAction}
+          href={user ? "/account/settings" : "/login?notice=email-confirmed"}
+        >
+          {user ? "Continue to my account" : "Log in to continue"}
+        </Link>
+        <Link className={styles.secondaryAction} href="/start-here">
+          Browse learning paths
+        </Link>
+      </div>
+    </AccountShell>
+  );
+}
