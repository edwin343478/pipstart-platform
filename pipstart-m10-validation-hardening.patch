+        errors.push("quiz preview question count must be a positive integer");
+      }
+      break;
+    default: {
+      const exhaustiveBlock: never = block;
+      errors.push(
+        `unknown lesson block: ${String((exhaustiveBlock as { type?: unknown }).type)}`,
+      );
+    }
+  }
 }
 
