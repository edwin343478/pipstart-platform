@@ -0,0 +1,65 @@
+"use client";
+
+import { useSyncExternalStore } from "react";
+
+function formatRelativeTime(publishedAt: string, now: Date): string {
+  const published = new Date(publishedAt);
+  const diffSeconds = Math.round((now.getTime() - published.getTime()) / 1000);
+
+  if (diffSeconds < 60) return "just now";
+  const diffMinutes = Math.round(diffSeconds / 60);
+  if (diffMinutes < 60)
+    return diffMinutes === 1 ? "1 minute ago" : `${diffMinutes} minutes ago`;
+  const diffHours = Math.round(diffMinutes / 60);
+  if (diffHours < 24)
+    return diffHours === 1 ? "1 hour ago" : `${diffHours} hours ago`;
+  const diffDays = Math.round(diffHours / 24);
+  if (diffDays < 7)
+    return diffDays === 1 ? "1 day ago" : `${diffDays} days ago`;
+  if (diffDays < 30) {
+    const diffWeeks = Math.round(diffDays / 7);
+    return diffWeeks === 1 ? "1 week ago" : `${diffWeeks} weeks ago`;
+  }
+  if (diffDays < 365) {
+    const diffMonths = Math.round(diffDays / 30);
+    return diffMonths === 1 ? "1 month ago" : `${diffMonths} months ago`;
+  }
+  const diffYears = Math.round(diffDays / 365);
+  return diffYears === 1 ? "1 year ago" : `${diffYears} years ago`;
+}
+
+function formatAbsoluteDate(publishedAt: string): string {
+  return new Date(publishedAt).toLocaleDateString("en-US", {
+    year: "numeric",
+    month: "short",
+    day: "numeric",
+  });
+}
+
+function subscribeToClock(onTick: () => void): () => void {
+  const intervalId = window.setInterval(onTick, 60_000);
+  return () => window.clearInterval(intervalId);
+}
+
+interface RelativeTimeProps {
+  publishedAt: string;
+  className?: string;
+}
+
+export function RelativeTime({ publishedAt, className }: RelativeTimeProps) {
+  const label = useSyncExternalStore(
+    subscribeToClock,
+    () => formatRelativeTime(publishedAt, new Date()),
+    () => formatAbsoluteDate(publishedAt),
+  );
+
+  return (
+    <time
+      dateTime={publishedAt}
+      title={formatAbsoluteDate(publishedAt)}
+      className={className}
+    >
+      {label}
+    </time>
+  );
+}

