+  background: #fff;
+}
+
+.brand {
+  color: #0b1220;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: 1.25rem;
+  font-weight: 800;
+  text-decoration: none;
+}
+
+.content {
+  width: min(100% - 2rem, 64rem);
+  margin: 0 auto;
+  padding: 2.5rem 0 4rem;
+}
+
+.breadcrumbs {
+  margin-bottom: 2rem;
+}
+
+.eyebrow {
+  margin: 0 0 0.5rem;
