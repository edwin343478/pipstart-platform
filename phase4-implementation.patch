+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.content h1 {
+  margin: 0;
+  font-family: var(--font-pipstart-heading), sans-serif;
+  font-size: clamp(2rem, 5vw, 3rem);
+  letter-spacing: -0.035em;
+}
+
+.lead {
+  max-width: 44rem;
+  margin: 1rem 0 2.5rem;
+  color: #475467;
+  font-size: 1rem;
+  line-height: 1.75;
+}
+
+.sectionHeading {
+  margin: 0 0 1rem;
+  font-size: 1.125rem;
+}
+
+.cards {
+  display: grid;
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.card {
+  display: grid;
+  gap: 0.75rem;
+  border: 1px solid #d9e0e5;
+  border-radius: 0.875rem;
+  background: #fff;
+  padding: 1.5rem;
+  color: inherit;
+  text-decoration: none;
+  box-shadow: 0 0.3rem 1.25rem rgb(15 23 42 / 4%);
+}
+
+.card:hover,
+.card:focus-visible {
+  border-color: #0f766e;
+  box-shadow: 0 0.5rem 1.5rem rgb(15 118 110 / 10%);
+}
+
+.meta {
+  color: #0f766e;
+  font-size: 0.75rem;
+  font-weight: 700;
+  text-transform: uppercase;
+}
+
+.card h2,
+.card h3 {
+  margin: 0;
+  font-size: 1.25rem;
+}
+
+.card p {
+  margin: 0;
+  color: #667085;
+  line-height: 1.65;
+}
+
+.action {
+  color: #0f766e;
+  font-size: 0.875rem;
+  font-weight: 700;
+}
+
+.footer {
+  border-top: 1px solid #d9e0e5;
+  background: #fff;
+  padding: 1.5rem;
+  color: #667085;
+  font-size: 0.75rem;
+  text-align: center;
+}
+
+@media (max-width: 479px) {
+  .header {
+    padding: 0.875rem 1rem;
+  }
+
+  .content {
+    width: min(100% - 1.25rem, 64rem);
